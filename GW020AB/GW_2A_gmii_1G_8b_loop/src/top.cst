//================  sys ==================================
IO_LOC "i_rst_n" 		T6;

IO_LOC "i_uart_rx" 		T13;
IO_LOC "o_uart_tx" 		M11;

//============ GW020AB HDMI侧排针
IO_LOC "i_gmii_rx_valid"        R8;
IO_LOC "i_gmii_rx_data[0]"      T7;
IO_LOC "i_gmii_rx_data[1]"      T12;
IO_LOC "i_gmii_rx_data[2]"      R11;
IO_LOC "i_gmii_rx_data[3]"      P13;
IO_LOC "i_gmii_rx_clk"          R12;
IO_LOC "i_gmii_rx_data[4]"      T14;
IO_LOC "i_gmii_rx_data[5]"      R13;
IO_LOC "i_gmii_rx_data[6]"      K11;
IO_LOC "i_gmii_rx_data[7]"      L13;
IO_LOC "i_gmii_rx_err"          K13;
IO_LOC "o_gmii_tx_clk"          H13;
IO_LOC "o_gmii_tx_valid"        G11;
IO_LOC "o_gmii_tx_data[0]"      H12;
IO_LOC "o_gmii_rst_n"           E16;
IO_LOC "o_gmii_tx_data[1]"      A13;
IO_LOC "o_gmii_tx_data[2]"      C13;
IO_LOC "o_gmii_tx_data[3]"      F15;
IO_LOC "o_gmii_tx_data[4]"      D16;
IO_LOC "o_gmii_tx_data[5]"      A9;
IO_LOC "o_gmii_tx_data[6]"      C9;
IO_LOC "o_gmii_tx_data[7]"      J11;
IO_LOC "o_gmii_tx_err"          L12;

//================IO 电平设置==================================
IO_PORT "i_rst_n"               IO_TYPE=LVCMOS33;
IO_PORT "i_uart_rx"             IO_TYPE=LVCMOS33;
IO_PORT "o_uart_tx"             IO_TYPE=LVCMOS33;
IO_PORT "i_gmii_rx_valid"       IO_TYPE=LVCMOS33;
IO_PORT "i_gmii_rx_data[0]"     IO_TYPE=LVCMOS33;
IO_PORT "i_gmii_rx_data[1]"     IO_TYPE=LVCMOS33;
IO_PORT "i_gmii_rx_data[2]"     IO_TYPE=LVCMOS33;
IO_PORT "i_gmii_rx_data[3]"     IO_TYPE=LVCMOS33;
IO_PORT "i_gmii_rx_clk"         IO_TYPE=LVCMOS33;
IO_PORT "i_gmii_rx_data[4]"     IO_TYPE=LVCMOS33;
IO_PORT "i_gmii_rx_data[5]"     IO_TYPE=LVCMOS33;
IO_PORT "i_gmii_rx_data[6]"     IO_TYPE=LVCMOS33;
IO_PORT "i_gmii_rx_data[7]"     IO_TYPE=LVCMOS33;
