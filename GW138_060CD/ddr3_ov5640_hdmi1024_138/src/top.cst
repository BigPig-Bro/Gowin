IO_PORT "io_cmos_sda"   IO_TYPE=LVCMOS33;
IO_PORT "i_cmos_vsync"  IO_TYPE=LVCMOS33;
IO_PORT "i_cmos_href"   IO_TYPE=LVCMOS33;
IO_PORT "i_cmos_pclk"   IO_TYPE=LVCMOS33;
